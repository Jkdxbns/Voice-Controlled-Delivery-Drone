# Server URL (FlaskServer_v12)
ARM_SERVER_URL=http://192.168.1.50:5000

# Jetson identity (WebSocket register payload)
ARM_JETSON_MAC=02:00:00:00:00:99
ARM_DEVICE_ID=jetson-arm-01
ARM_DEVICE_NAME=Jetson Arm Controller
ARM_MODEL_NAME=NVIDIA Jetson

# Arm device identity advertised via bt_update
ARM_TARGET_MAC=AA:BB:CC:DD:EE:01
ARM_TARGET_NAME=robotic-arm
ARM_TARGET_TYPE=classic

# Serial command passthrough to Arduino/MCU
ARM_SERIAL_ENABLED=1
# ARM_SERIAL_PORT=       # leave unset for auto-detect, or set to e.g. /dev/ttyUSB0
ARM_SERIAL_BAUD=115200
ARM_SERIAL_TIMEOUT=2.0

# Keepalive
ARM_PING_INTERVAL=15
